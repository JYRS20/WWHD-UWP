<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
 IgnorableNamespaces="uap rescap">
 <Identity Name="WWHDRecomp.UWP.GameTest" Publisher="CN=WWHDRecompDevelopment" Version="0.0.2.13" ProcessorArchitecture="x64"/>
 <Properties><DisplayName>WWHD UWP Experimental</DisplayName><PublisherDisplayName>WWHD UWP Development</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
 <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0"/>
 <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US"/></Dependencies>
 <Resources><Resource Language="en-us"/></Resources>
 <Applications><Application Id="App" Executable="wwhd-uwp-game.exe" EntryPoint="WWHD.GameTest.App">
 <uap:VisualElements DisplayName="WWHD UWP Experimental" Description="Private experimental Wind Waker HD UWP runtime."
 Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" BackgroundColor="#102838">
 <uap:SplashScreen Image="Assets\SplashScreen.png"/></uap:VisualElements>
 <Extensions><uap:Extension Category="windows.fileTypeAssociation"><uap:FileTypeAssociation Name="wwhd-game-data"><uap:SupportedFileTypes><uap:FileType>.aaf</uap:FileType><uap:FileType>.asn</uap:FileType><uap:FileType>.aw</uap:FileType><uap:FileType>.baglenv</uap:FileType><uap:FileType>.bdt</uap:FileType><uap:FileType>.bfma</uap:FileType><uap:FileType>.bfsar</uap:FileType><uap:FileType>.bfstm</uap:FileType><uap:FileType>.btsnd</uap:FileType><uap:FileType>.gsh</uap:FileType><uap:FileType>.h264</uap:FileType><uap:FileType>.pack</uap:FileType><uap:FileType>.rpx</uap:FileType><uap:FileType>.sarc</uap:FileType><uap:FileType>.sharcfb</uap:FileType><uap:FileType>.szs</uap:FileType><uap:FileType>.tga</uap:FileType><uap:FileType>.xml</uap:FileType></uap:SupportedFileTypes></uap:FileTypeAssociation></uap:Extension></Extensions>
 </Application></Applications>

 <Capabilities>
  <Capability Name="internetClient"/>
  <uap:Capability Name="removableStorage"/>
  <rescap:Capability Name="extendedExecutionUnconstrained"/>
 </Capabilities>
</Package>

