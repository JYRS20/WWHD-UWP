# Generate forwarding stubs and native-hook exports from public runtime source only.
# This never reads an RPX, generated game C, funcs.h or compiled game objects.
function(wwhd_dynamic_bindings ROOT OUTPUT)
 file(GLOB_RECURSE INPUTS CONFIGURE_DEPENDS "${ROOT}/runtime/src/*.cpp" "${ROOT}/runtime/src/*.c" "${ROOT}/runtime/src/*.h" "${ROOT}/runtime/src/*.mm")
 set(REFS "")
 foreach(INPUT IN LISTS INPUTS)
  file(READ "${INPUT}" TEXT)
  string(REGEX MATCHALL "f_[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f](_orig)?" FOUND "${TEXT}")
  list(APPEND REFS ${FOUND})
 endforeach()
 list(REMOVE_DUPLICATES REFS)
 list(SORT REFS)
 file(GLOB HOOK_FILES CONFIGURE_DEPENDS "${ROOT}/tools/recomp/hooks*.txt")
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${INPUTS} ${HOOK_FILES})
 set(HOOKS "")
 foreach(INPUT IN LISTS HOOK_FILES)
  file(STRINGS "${INPUT}" LINES)
  foreach(LINE IN LISTS LINES)
   string(REGEX REPLACE "#.*" "" LINE "${LINE}")
   string(STRIP "${LINE}" LINE)
   if(LINE MATCHES "^@([0-9A-Fa-f]+)$")
    list(APPEND HOOKS "site_${CMAKE_MATCH_1}")
   elseif(LINE MATCHES "^([0-9A-Fa-f]+)$")
    list(APPEND HOOKS "hook_${CMAKE_MATCH_1}")
    list(APPEND REFS "f_${CMAKE_MATCH_1}" "f_${CMAKE_MATCH_1}_orig")
   endif()
  endforeach()
 endforeach()
 list(REMOVE_DUPLICATES REFS)
 list(SORT REFS)
 list(REMOVE_DUPLICATES HOOKS)
 list(SORT HOOKS)
 set(TEXT "// Generated exclusively from public runtime declarations and hooks. No game instructions.\n#include \"dynamic_game.h\"\n")
 foreach(REF IN LISTS REFS)
  string(APPEND TEXT "static PpcFunc target_${REF}=nullptr;\nextern \"C\" void ${REF}(Cpu* c){ MUSTTAIL return target_${REF}(c); }\n")
 endforeach()
 string(APPEND TEXT "void dynamic_game_bind_forwarders(WwhdLinkedImage* image){\n")
 foreach(REF IN LISTS REFS)
  string(APPEND TEXT " target_${REF}=reinterpret_cast<PpcFunc>(wwhd_clang_link_find(image,\"${REF}\"));\n if(!target_${REF})throw std::runtime_error(\"Missing loaded guest function ${REF}\");\n")
 endforeach()
 string(APPEND TEXT "}\n")
 foreach(HOOK IN LISTS HOOKS)
  string(APPEND TEXT "extern \"C\" void ${HOOK}(Cpu*);\n")
 endforeach()
 string(APPEND TEXT "void dynamic_game_native_hooks(std::vector<WwhdRuntimeSymbol>& symbols){\n")
 foreach(HOOK IN LISTS HOOKS)
  string(APPEND TEXT " symbols.push_back({\"${HOOK}\",reinterpret_cast<uint64_t>(&${HOOK}),WWHD_LINK_FUNCTION});\n")
 endforeach()
 string(APPEND TEXT "}\n")
 # stdexcept is intentionally separate from game ABI headers.
 string(PREPEND TEXT "#include <stdexcept>\n")
 file(WRITE "${OUTPUT}" "${TEXT}")
endfunction()
